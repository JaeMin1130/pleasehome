[Unit]
Description=PleaseHome Admin Console (3001)
After=network-online.target
Wants=network-online.target

[Service]
User=iru
WorkingDirectory=/home/iru/app/pleasehome/admin-console
ExecStart=/home/iru/app/pleasehome/db-pipeline/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 3001
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

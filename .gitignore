# Exclude everything by default (최상위 루트 하위의 모든 파일과 폴더를 기본 무시)
/*

# Whitelist allowed directories & files (추적을 허용할 핵심 자산 화이트리스트)
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/llms.txt
!/command.sh
!/.agents/
!/docs/
!/web/
!/db-pipeline/
!/backend/

# Blacklist
/docs/reference
/db-pipeline/docs/pdf/LH_*
/db-pipeline/docs/pdf/SH_*
/db-pipeline/docs/pdf/GH_*
/db-pipeline/docs/pdf/!old
/db-pipeline/docs/md/
/db-pipeline/scratch/
/web/.next/
/web/node_modules/
/backend/.gradle/
/backend/build/
/backend/.kotlin/
!/db-pipeline/.venv/
*.db
*.pem
*.pub
*.gz
*.pyc
*.log
*.env*
!/.env.example
# Exclude everything by default (최상위 루트 하위의 모든 파일과 폴더를 기본 무시)
/*

# Whitelist allowed directories & files (추적을 허용할 핵심 자산 화이트리스트)
!/.gitignore
!/README.md

# Allow diving into frontend and backend directories
!/frontend/
!/backend/

# Ignore all files inside frontend and backend by default
/frontend/*
/backend/*

# Whitelist src directories and package.json
!/frontend/src/
!/backend/src/
!/frontend/package.json
!/backend/package.json

# Ignore build artifacts and caches
**/__pycache__/
*.pyc
*.pyo
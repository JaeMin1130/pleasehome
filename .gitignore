# Exclude everything by default (최상위 루트 하위의 모든 파일과 폴더를 기본 무시)
/*

# Whitelist allowed directories & files (추적을 허용할 핵심 자산 화이트리스트)
!/.gitignore
!/README.md
!/AGENTS.md
!/llms.txt
!/.env.example
!/.agents/
!/docs/
!/web/
!/db-pipeline/

# Blacklist
/docs/pdf/LH_*
/docs/pdf/SH_*
/docs/pdf/GH_*
/docs/md/
/web/.next/
/web/node_modules/
!/db-pipeline/.venv/
*.db
*.env.local
*.pem
*.gz
*.pyc